[Unit]
Description=punto-rs — исправление раскладки набранного текста
Documentation=https://github.com/netherguy4/punto-rs
After=systemd-logind.service
Wants=systemd-logind.service

[Service]
Type=simple
ExecStart=/usr/local/bin/punto-rs
ExecStartPre=/usr/local/bin/punto-rs --check-config
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=2
RuntimeDirectory=punto-rs
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
LimitCORE=0

# Нужен доступ к /dev/input/* на чтение и к /dev/uinput на запись.
DeviceAllow=/dev/uinput rw
DeviceAllow=char-input r
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
MemoryMax=64M

[Install]
WantedBy=multi-user.target
